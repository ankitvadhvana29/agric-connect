# AgriConnect Server Environment Configuration

PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# If using local MongoDB: mongodb://localhost:27017/agriconnect
# If using MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/agriconnect
MONGO_URI=mongodb://127.0.0.1:27017/agriconnect

# Authentication Secret
JWT_SECRET=agriconnect_sih_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# UPI Payment Gateway Details
FOUNDER_UPI_ID=agriconnect.escrow@okhdfcbank
FOUNDER_MERCHANT_NAME=AgriConnect Escrow
FOUNDER_COMMISSION_PERCENTAGE=5

# Gemini AI (Optional - for Vision API produce analysis)
# If left blank, intelligent agricultural heuristic & mandi price engine is used
GEMINI_API_KEY=

# Server Base URL for uploaded images
BASE_URL=http://localhost:5000
